# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=123456789:replace-with-your-bot-token

# Only this numeric Telegram user ID may use the bot.
ALLOWED_TELEGRAM_USER_ID=123456789

# Safe defaults for the public Telegram Bot API.
MAX_FILE_BYTES=49000000
MAX_DURATION_SECONDS=7200
DOWNLOAD_TIMEOUT_SECONDS=900
METADATA_TIMEOUT_SECONDS=45
PENDING_REQUEST_TTL_SECONDS=600
LOG_LEVEL=INFO

# Reserved for a future Telegram Local Bot API deployment.
# TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081/bot
# TELEGRAM_FILE_BASE_URL=http://telegram-bot-api:8081/file/bot
# TELEGRAM_LOCAL_MODE=true
